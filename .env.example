# Kōri settings, every key (tech.md §15.3). Values below are the defaults.
# The API reads .env on start and refuses unknown keys. Lists: a,b. Maps: key:value,key:value.

# App. APP_ENV: dev | ci | staging | prod; staging behaves like prod but allows fakes.
APP_ENV=dev
APP_BASE_URL=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
DATA_DIR=/data
JOBS_ENABLED=true

# DB. On the VPS put the same password into postgres.env as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
DB_POOL_SIZE=10

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=doc_chunks

# Auth. REGISTRATION_MODE: open | invite | closed. staging and prod need COOKIE_SECURE=true.
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
REGISTRATION_MODE=invite
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=

# T-Invest. Every *_MODE: fake | real (VECTORS_MODE: memory | qdrant); prod forbids fakes.
# TINVEST_TOKEN_KEYS: key_id:<base64 of 32 bytes>, comma-separated for rotation. New key:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TINVEST_MODE=fake
TINVEST_APP_NAME=kori
TINVEST_SYSTEM_TOKEN=
TINVEST_TOKEN_KEYS=
TINVEST_TOKEN_ACTIVE_KEY=k1
TINVEST_TIMEOUT_S=20

# LLM
LLM_MODE=fake
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca.pem
GIGACHAT_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_TIMEOUT_S=90
LLM_MODELS=lite:GigaChat-2,pro:GigaChat-2-Pro,max:GigaChat-2-Max,ultra:GigaChat-3-Ultra
LLM_TOOLS_UNSUPPORTED=
LLM_CONTEXT_TOKENS=lite:32000,pro:32000,max:32000,ultra:32000

# Quotas
LLM_QUOTAS=lite:250000000,pro:40000000,max:25000000,ultra:50000000
LLM_QUOTA_PERIOD_START=2026-09-26
LLM_QUOTA_PERIOD_DAYS=365
LLM_PACE_MAX=1.15
LLM_PACE_GRACE_DAYS=7
LLM_RESERVE_PCT=1
USER_DAILY_BUDGET_LITE_EQ=600000
BACKGROUND_DAILY_BUDGET_LITE_EQ=1500000

# Agent
AGENT_HISTORY_MESSAGES=8
AGENT_RUN_TIMEOUT_S=240
AGENT_RUN_BUDGET_LITE_EQ=400000
TOOL_TIMEOUT_S=60
RUN_EVENTS_TTL_S=600

# Web
WEB_MODE=fake
TAVILY_API_KEY=
TAVILY_MONTHLY_CREDITS=1000
TAVILY_USER_DAILY_CREDITS=40
WEB_CACHE_TTL_SEARCH_S=21600
WEB_CACHE_TTL_EXTRACT_S=604800

# Disclosures: the real adapter drives Chromium, the site refuses clients without a browser.
DISCLOSURE_MODE=fake
EDISCLOSURE_BASE_URL=https://www.e-disclosure.ru
EDISCLOSURE_RPS=0.5
DISCLOSURE_YEARS_BACK=5

# Vectors
EMBEDDINGS_MODE=fake
EMBEDDINGS_DENSE_MODEL=intfloat/multilingual-e5-small
EMBEDDINGS_SPARSE_MODEL=Qdrant/bm25
FASTEMBED_CACHE_DIR=/data/fastembed
VECTORS_MODE=memory

# Media
FETCH_MODE=fake
MEDIA_MAX_BYTES=5242880

# Fakes. FAKE_FAULTS: path to a FaultPlan file, dev and ci only.
FAKE_FAULTS=
FAKE_STRICT=false

# Frontend build
PUBLIC_KITCHEN_SINK=0
