{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "tavily",
      "listen": "0.0.0.0",
      "port": 8080,
      "protocol": "http",
      "settings": {}
    }
  ],
  "outbounds": [
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "observatory": {
    "subjectSelector": ["node-"],
    "probeUrl": "https://www.google.com/generate_204",
    "probeInterval": "1m",
    "enableConcurrency": true
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["tavily"],
        "domain": ["domain:tavily.com"],
        "balancerTag": "exits"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "block"
      }
    ],
    "balancers": [
      {
        "tag": "exits",
        "selector": ["node-"],
        "strategy": {
          "type": "leastPing"
        },
        "fallbackTag": "block"
      }
    ]
  }
}
